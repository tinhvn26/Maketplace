# Generate two independent random secrets (at least 32 bytes each).
# Do not use example values or commit your .env file.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
DATABASE_URL="file:./dev.db"

# Development: queue email locally in the IdentityMail table without sending.
# Set smtp to enable delivery. Production requires smtp and TLS.
# Gmail: enable Google 2-Step Verification and create an App Password.
# Use smtp.gmail.com, port 587, SECURE=false, REQUIRE_TLS=true.
# Set SMTP_USER to the sender Gmail address and SMTP_FROM to that same address
# (optionally formatted as "Marketplate <your-sender@gmail.com>").
# SMTP_PASSWORD is the Google App Password without display spaces, not a normal
# Gmail or Marketplate login password. See README.md for the complete recipe.
IDENTITY_MAIL_TRANSPORT=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Optional frontend base URL (no query/fragment) for /verify-email and
# /change-email confirmation screens; otherwise those emails contain tokens.
# Password-reset emails always contain a 6-digit OTP; this URL is not required.
IDENTITY_PUBLIC_APP_URL=

# Managed media: local development storage and the externally visible API origin.
# Use shared/object storage for multiple instances; production requires HTTPS.
MEDIA_STORAGE_PATH=./var/media
MEDIA_PUBLIC_BASE_URL=http://localhost:3000
